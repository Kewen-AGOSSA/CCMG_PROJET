rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function estDansMapSousFamille(mapObj, email) {
      return mapObj is map && (
        email in mapObj.get('JAC Anglophone 1', []) ||
        email in mapObj.get('JAC Anglophone 2', []) ||
        email in mapObj.get('JAC Fidélité', []) ||
        email in mapObj.get('JAC Gloire', []) ||
        email in mapObj.get('JAC Honneur', []) ||
        email in mapObj.get('JAC Humilité', []) ||
        email in mapObj.get('JAC Louange', []) ||
        email in mapObj.get('JAC Puissance', []) ||
        email in mapObj.get('JAC Richesse', []) ||
        email in mapObj.get('JAC Sagesse', []) ||
        email in mapObj.get('CCMG Anglophone 1', []) ||
        email in mapObj.get('CCMG Anglophone 2', []) ||
        email in mapObj.get('CCMG Fidélité', []) ||
        email in mapObj.get('CCMG Gloire', []) ||
        email in mapObj.get('CCMG Honneur', []) ||
        email in mapObj.get('CCMG Humilité', []) ||
        email in mapObj.get('CCMG Louange', []) ||
        email in mapObj.get('CCMG Puissance', []) ||
        email in mapObj.get('CCMG Richesse', []) ||
        email in mapObj.get('CCMG Sagesse', []) ||
        email in mapObj.get('GÉDÉON', []) ||
        email in mapObj.get('MIDL', [])
      );
    }

    // Fonction de vérification des rôles classiques (inclut les ouvriers)
    function aRole(idContexte) {
      let email = request.auth.token.email.lower();
      let config = get(/databases/$(database)/documents/configuration/emails_autorises).data;
      
      return email in config.get('fondateurs', [])
          || (idContexte in config && (
               (config[idContexte].get('pasteur', []) is list && email in config[idContexte].get('pasteur', []))
            || (config[idContexte].get('evangeliste', []) is list && email in config[idContexte].get('evangeliste', []))
            || (config[idContexte].get('ouvrier', []) is list && email in config[idContexte].get('ouvrier', []))
            || estDansMapSousFamille(config[idContexte].get('evangeliste', {}), email)
            || estDansMapSousFamille(config[idContexte].get('ouvrier', {}), email)
          ));
    }

    // NOUVELLE FONCTION : Uniquement pour les responsables (bloque les ouvriers)
    function aRoleResponsable(idContexte) {
      let email = request.auth.token.email.lower();
      let config = get(/databases/$(database)/documents/configuration/emails_autorises).data;
      
      return email in config.get('fondateurs', [])
          || (idContexte in config && (
               (config[idContexte].get('pasteur', []) is list && email in config[idContexte].get('pasteur', []))
            || (config[idContexte].get('evangeliste', []) is list && email in config[idContexte].get('evangeliste', []))
            || estDansMapSousFamille(config[idContexte].get('evangeliste', {}), email)
          ));
    }

    // LISTE DES EMAILS : Lecture seule pour les membres connectés
    match /configuration/emails_autorises {
      allow read: if request.auth != null;
      allow write: if false; 
    }

    // VILLES : Séparation des droits de suppression
    match /villes/{villeId}/{colId}/{doc=**} {
      
      // Tout le monde peut lire et modifier les données
      allow read, create, update: if request.auth != null && 
                                  colId == 'donnees' && 
                                  aRole(villeId);
                                  
      // SEULS les responsables peuvent supprimer des données
      allow delete: if request.auth != null && 
                    colId == 'donnees' && 
                    aRoleResponsable(villeId);
                    
      // SEULS les responsables ont accès à la liste des anciens
      allow read, write: if request.auth != null && 
                         colId == 'anciens' && 
                         aRoleResponsable(villeId);
    }
    
    // PROGRAMMES : Séparation des droits de suppression
    match /programmes/{progId}/{colId}/{doc=**} {
      
      // Tout le monde peut lire et modifier les données
      allow read, create, update: if request.auth != null && 
                                  colId == 'donnees' && 
                                  (aRole(progId) || aRole('_programmes_speciaux'));
                                  
      // SEULS les responsables peuvent supprimer des données
      allow delete: if request.auth != null && 
                    colId == 'donnees' && 
                    (aRoleResponsable(progId) || aRoleResponsable('_programmes_speciaux'));

      // SEULS les responsables ont accès à la liste des anciens
      allow read, write: if request.auth != null && 
                         colId == 'anciens' && 
                         (aRoleResponsable(progId) || aRoleResponsable('_programmes_speciaux'));
    }

    // ANCIENNE STRUCTURE (Contacts) : Réservée au Père Fondateur
    match /contacts/{doc=**} {
      allow read: if request.auth != null && 
        (request.auth.token.email.lower() in get(/databases/$(database)/documents/configuration/emails_autorises).data.get('fondateurs', []));
      allow write: if false;
    }

    // EBED 2026 — Pointage Convention
    match /ebed_participants/{id} {
      allow read, write: if true;
    }
    match /ebed_pointages/{id} {
      allow read, write: if true;
    }

    // TRANSFERTS - Utilisé par la Cloud Function pour l'envoi d'emails
    match /transferts/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if false; // Le backend (Admin SDK) a toujours tous les droits
    }

    // TOKENS DE NOTIFICATION
    match /users_tokens/{email} {
      allow read, write: if request.auth != null && request.auth.token.email == email;
    }
  }
}
